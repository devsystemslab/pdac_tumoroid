#!/bin/bash
#BSUB -J dask_scheduler       # Job name
#BSUB -n 1             # number of tasks
#BSUB -q long         # Select queue
#BSUB -W 180:00         # Wall-clock time (hrs:mins)
#BSUB -R "rusage[mem=64GB/host]"
#BSUB -o pilotscreen-%J.out # Output file
#BSUB -e pilotscreen-%J.err # Error file

METADATA=metafiles/imaging_data_overview.csv
CONFIG=configs/config_pilotscreen.yaml

PLATES=$(awk -F',' '$1 == "pilotscreen" {print $2}' $METADATA)
PLATES=$(echo $PLATES | tr ' ' '\n' | sort -u | tr '\n' ' ')

for PLATE in $PLATES
do
    echo "Processing plate $PLATE"
    python image_processing/cli.py $PLATE --config $CONFIG
done
