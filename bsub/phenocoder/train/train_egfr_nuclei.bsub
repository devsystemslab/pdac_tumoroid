#!/bin/bash
#BSUB -J train_phenocoder_egfr_1st_cycle_nuclei  # Job name
#BSUB -n 2                               # number of tasks
#BSUB -R "span[hosts=1]"                 # Allocate all tasks in 1 host
#BSUB -q long                        # Select queue
#BSUB -W 300:00                          # walltime
#BSUB -gpu "num=1:j_exclusive=yes"       # Request 1 GPU exclusive for the job
#BSUB -o logs/train_phenocoder_egfr_1st_cycle_nuclei-%J.out                   # Output file
#BSUB -e logs/train_phenocoder_egfr_1st_cycle_nuclei-%J.err                   # Error file
#BSUB -R "rusage[mem=200GB/host]"        # Memory requirement

TMP_DIR=/home/harmelc/scratch/datasets/egfr/1st_cycle_nuclei
mkdir -p $TMP_DIR
DATA_DIR=/pstore/data/ihb-tumoroid/data/processed/egfr/phenocoder/1st_cycle_nuclei
echo "Copying $DATA_DIR to $TMP_DIR"
rclone copy $DATA_DIR $TMP_DIR

BETAS=(0.01 0.1 0.5 1)
DENSE_DIMS=(32 64 128 256)
LATENT_DIMS=(16 32 64 128)
LEN_DIMS=${#DENSE_DIMS[@]}
PYTHON_SCRIPT=/pstore/home/harmelc/tumoroid/whole_mount_tumoroid/phenocoder/train.py

for BETA in ${BETAS[@]}; do
  for ((i=1;i<=$LEN_DIMS;i++)); do
        python $PYTHON_SCRIPT $TMP_DIR --n_dense_dim ${DENSE_DIMS[$i]} --n_latent_dim ${LATENT_DIMS[$i]} --conditional --n_workers 2 --beta $BETA
    done
done

rclone copy $TMP_DIR/models $DATA_DIR/models
rclone copy $TMP_DIR/tensorboard_logs $DATA_DIR/tensorboard_logs
rclone purge $TMP_DIR