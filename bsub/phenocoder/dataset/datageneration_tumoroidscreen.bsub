#!/bin/bash
#BSUB -J phenocoder-datagen      # Job name
#BSUB -n 12           # number of tasks
#BSUB -R "span[hosts=1]"  # all jobs in one host
#BSUB -q long         # Select queue
#BSUB -W 360:00         # Wall-clock time (hrs:mins)
#BSUB -o datageneration_tumoroidscreen-%J_%I.out   # Output files
#BSUB -e datageneration_tumoroidscreen-%J_%I.err   # Error files
#BSUB -R "rusage[mem=100GB/host]"


PLATES=$(awk -F',' '$1 == "tumoroidscreen" {print $2}' metafiles/imaging_data_overview.csv)
PLATES=$(echo $PLATES | tr ' ' '\n' | sort -u | tr '\n' ' ')
DIR_SCREEN=data/tumoroidscreen
PYTHON_SCRIPT=phenocoder/dataset.py
for PLATE in $PLATES
do
    echo "Processing plate $PLATE - 1st cycle"
    DIR_INPUT=$DIR_SCREEN/$PLATE/$PLATE-01/TIF_OVR_BG
    DIR_OUTPUT=$DIR_SCREEN/phenocoder/1st_cycle/$PLATE-01
    python $PYTHON_SCRIPT $DIR_INPUT $DIR_OUTPUT --max_workers 12

    echo "Processing plate $PLATE - 2nd cycle"
    DIR_INPUT=$DIR_SCREEN/$PLATE/$PLATE-03/TIF_OVR_BG
    DIR_OUTPUT=$DIR_SCREEN/phenocoder/2nd_cycle/$PLATE-03
    python $PYTHON_SCRIPT $DIR_INPUT $DIR_OUTPUT --max_workers 12
done
