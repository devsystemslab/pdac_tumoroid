#!/bin/bash
#BSUB -J dask_scheduler       # Job name
#BSUB -n 1             # number of tasks
#BSUB -q long         # Select queue
#BSUB -W 360:00         # Wall-clock time (hrs:mins)
#BSUB -R "rusage[mem=64GB/host]"
#BSUB -o logs/output-%J.out # Output file
#BSUB -e logs/output-%J.err # Error file

DIR_TUMOROID=/pstore/home/harmelc/tumoroid/whole_mount_tumoroid
cd /pstore/home/harmelc/tumoroid || exit
PLATES=$(awk -F',' '$1 == "tumoroidscreen_3" {print $2}' $DIR_TUMOROID/metafiles/imaging_data_overview.csv)
PLATES=$(echo $PLATES | tr ' ' '\n' | sort -u | tr '\n' ' ')
CONFIG=$DIR_TUMOROID/configs/config_tumoroidscreen_3.yaml

for PLATE in $PLATES
do
    echo "Processing plate $PLATE"
    python $DIR_TUMOROID/image_processing/cli.py $PLATE --config $CONFIG
done
