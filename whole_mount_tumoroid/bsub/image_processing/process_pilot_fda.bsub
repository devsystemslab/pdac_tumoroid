#!/bin/bash
#BSUB -J dask_scheduler       # Job name
#BSUB -n 1             # number of tasks
#BSUB -q long         # Select queue
#BSUB -W 72:00         # Wall-clock time (hrs:mins)
#BSUB -R "rusage[mem=64GB/host]"
#BSUB -o output-%J.out # Output file
#BSUB -e output-%J.err # Error file

PLATES=$(awk -F',' '$1 == "pilot_fda" {print $2}' whole_mount_tumoroid/metafiles/imaging_data_overview.csv)
PLATES=$(echo $PLATES | tr ' ' '\n' | sort -u | tr '\n' ' ')

CONFIG=whole_mount_tumoroid/configs/config_pilot_fda.yaml

for PLATE in $PLATES
do
    echo "Processing plate $PLATE"
    python whole_mount_tumoroid/image_processing/cli.py $PLATE --config $CONFIG
done
