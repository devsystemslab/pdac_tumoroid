#!/bin/bash
#BSUB -J phenocoder-datagen      # Job name
#BSUB -n 32           # number of tasks
#BSUB -R "span[hosts=1]"  # all jobs in one host
#BSUB -q long         # Select queue
#BSUB -W 144:00         # Wall-clock time (hrs:mins)
#BSUB -o phenocoder-data-%J_%I.out   # Output files
#BSUB -e phenocoder-data-%J_%I.err   # Error files
#BSUB -R "rusage[mem=100GB/host]"

DIR_INPUT=/pstore/data/ihb-tumoroid/data/processed/egfr/007/007-01/TIF_OVR_BG
DIR_OUTPUT=/pstore/data/ihb-tumoroid/data/processed/egfr/phenocoder/1st_cycle/007-01
echo "DIR_INPUT: $DIR_INPUT"
echo "DIR_OUTPUT: $DIR_OUTPUT"
python phenocoder/dataset.py $DIR_INPUT $DIR_OUTPUT --max_workers 32

